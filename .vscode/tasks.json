{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  //
  // COM30 · Tareas de la sala: Terminal > Ejecutar tarea... (Ctrl+Shift+P, «Run Task»).
  // Las cuatro tareas «COM30 ·» corren en cmd con Node.js en el PATH, aunque
  // Windows no lo tenga configurado. Si Node.js está en otra carpeta, cambie la
  // ruta de "options.env.PATH".
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "C:\\Program Files\\nodejs;${env:APPDATA}\\npm;${env:PATH}"
    },
    "shell": {
      "executable": "cmd.exe",
      "args": ["/d", "/c"]
    }
  },
  "tasks": [
    {
      "label": "COM30 · 1 Verificar entorno",
      "type": "shell",
      "command": "node -v && npm -v && git --version",
      "problemMatcher": []
    },
    {
      "label": "COM30 · 2 Instalar dependencias",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "COM30 · 3 Servidor de desarrollo",
      "type": "shell",
      "command": "npx ng serve",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "COM30 · 4 Compilar",
      "type": "shell",
      "command": "npx ng build",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ]
}
